# LP Vol Analyzer (cmd/server) -------------------------------------------------
# All optional; defaults shown.
PORT=8080
DATA_SOURCE=demo          # "demo" (offline) or "live" (GeckoTerminal + Deribit)
SCAN_INTERVAL=10m         # wait between automatic scans: 30s, 5m, 1h, ...
POOLS_PER_CHAIN=8
# CHAINS=eth,base,arbitrum,optimism,bsc,solana,avax,polygon_pos
# GECKOTERMINAL_URL=https://api.geckoterminal.com/api/v2
# DERIBIT_URL=https://www.deribit.com/api/v2

# Tracked position & hedge ----------------------------------------------------
TRACK_TOKEN_ID=71002035   # Aerodrome (Base) position token ID to track
HEDGE_DRY_RUN=true        # false lets cmd/hedge place real orders

# On-chain + Binance (needed for DATA_SOURCE=live position tracking) -----------
# RPC_URL=                          # Base RPC endpoint
# BINANCE_TESTNET_API_KEY=
# BINANCE_TESTNET_API_SECRET=
