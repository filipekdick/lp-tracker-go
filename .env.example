# LP Vol Analyzer (cmd/server) -------------------------------------------------
# All optional; defaults shown.
PORT=8080
DATA_SOURCE=demo          # "demo" (offline) or "live" (GeckoTerminal + Deribit)
SCAN_INTERVAL=10m         # informational only — pool scans run on manual "Scan now" trigger, not a timer
POSITION_INTERVAL=3m      # how often the LP position + Binance hedge auto-refresh (independent of pool scans)
POOLS_PER_CHAIN=8             # Number of pools to keep per chain. Each pool requires an OHLCV request. With a 10 req/min free limit, keep this low.
# CHAINS=eth,base,arbitrum,optimism,bsc,solana,avax,polygon_pos
# DERIBIT_URL=https://www.deribit.com/api/v2

# GECKOTERMINAL_URL overrides the data endpoint. Leave it UNSET to use the
# CoinGecko onchain API (default), which is the only endpoint that honours the
# CG_API_KEY demo key below. Only point it at api.geckoterminal.com if you are
# NOT using a key (that host ignores CoinGecko keys, so you'd stay rate-limited).
# GECKOTERMINAL_URL=https://api.geckoterminal.com/api/v2

# Tracked positions & hedge ---------------------------------------------------
# TRACK_TOKEN_IDS takes a comma-separated list of Aerodrome (Base) position token
# IDs. Their volatile-leg exposure is summed per asset (synthetics like wstETH/
# cbETH fold into ETH) and hedged with ONE simplified short per asset.
TRACK_TOKEN_IDS=71002035  # e.g. 71002035,71002099,71003120
# TRACK_TOKEN_ID=71002035 # legacy single-id form, still honoured
HEDGE_DRY_RUN=true        # false lets cmd/hedge place real orders
# Hedge perp quote currency: "usdc" (default) hedges on token/USDC and only falls
# back to token/USDT when no USDC perp exists; "usdt" forces token/USDT.
HEDGE_QUOTE=usdc

# On-chain + Binance (needed for DATA_SOURCE=live position tracking) -----------
# RPC_URL=                          # Base RPC endpoint
# BINANCE_TESTNET_API_KEY=
# BINANCE_TESTNET_API_SECRET=

# CoinGecko demo API key — lifts the onchain rate limit to ~30 req/min, so the
# scanner polls ~3x faster. Get one free at coingecko.com (Developer dashboard).
# CG_API_KEY=
